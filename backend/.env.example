# Server
PORT=5000

# PostgreSQL
# Option A — cloud Postgres (Neon/Render/Supabase): paste the full connection
# string here and leave the DB_* fields below unused. SSL is enabled automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
#
# Option B — local PostgreSQL: leave DATABASE_URL unset and fill these in.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fleetopz

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

GROQ_API_KEY=your_groq_api_key_here